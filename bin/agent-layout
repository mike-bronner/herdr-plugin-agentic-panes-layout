#!/bin/sh
set -eu

PLUGIN_ROOT="${HERDR_PLUGIN_ROOT:-$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)}"
BIN="$PLUGIN_ROOT/target/release/agent-layout"

say() {
    printf 'agent-layout: %s\n' "$*" >&2
    if [ -n "${HERDR_BIN_PATH:-}" ] && [ -x "${HERDR_BIN_PATH:-}" ]; then
        "$HERDR_BIN_PATH" notification show "agent layout" --body "$*" >/dev/null 2>&1 || true
    fi
}
die() { say "$*"; exit 1; }

find_cargo() {
    if command -v cargo >/dev/null 2>&1; then
        command -v cargo
        return 0
    fi
    for candidate in \
        "${CARGO:-}" \
        "${CARGO_HOME:-$HOME/.cargo}/bin/cargo" \
        "$HOME/.cargo/bin/cargo" \
        /opt/homebrew/opt/rustup/bin/cargo \
        /opt/homebrew/bin/cargo \
        /usr/local/opt/rustup/bin/cargo \
        /usr/local/bin/cargo
    do
        [ -n "$candidate" ] && [ -x "$candidate" ] && { printf '%s\n' "$candidate"; return 0; }
    done
    return 1
}

needs_build() {
    [ -x "$BIN" ] || return 0
    [ -n "$(find "$PLUGIN_ROOT/src" "$PLUGIN_ROOT/Cargo.toml" "$PLUGIN_ROOT/Cargo.lock" \
            -newer "$BIN" -print -quit 2>/dev/null)" ]
}

if needs_build; then
    CARGO_BIN="$(find_cargo || true)"
    if [ -n "$CARGO_BIN" ]; then
        say "building the layout binary"
        CARGO_DIR="$(dirname -- "$CARGO_BIN")"
        PATH="$CARGO_DIR:$PATH" "$CARGO_BIN" \
            build --release --manifest-path "$PLUGIN_ROOT/Cargo.toml" >&2 \
            || die "cargo build --release failed in $PLUGIN_ROOT"
    elif [ -x "$BIN" ]; then
        say "cargo not found; running the binary already built, which may be stale"
    else
        die "cargo not found, and no binary at $BIN — run \`cargo build --release\` in $PLUGIN_ROOT once"
    fi
fi

[ -x "$BIN" ] || die "no layout binary at $BIN"

exec "$BIN" "$@"
