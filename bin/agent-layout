#!/bin/sh
set -eu

PLUGIN_ROOT="${HERDR_PLUGIN_ROOT:-$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)}"
BIN="$PLUGIN_ROOT/target/release/agent-layout"

say() {
    printf 'agent-layout: %s\n' "$*" >&2
    if [ -n "${HERDR_BIN_PATH:-}" ] && [ -x "${HERDR_BIN_PATH:-}" ]; then
        "$HERDR_BIN_PATH" notification show "agent layout" --body "$*" >/dev/null 2>&1 || true
    fi
}
die() { say "$*"; exit 1; }

needs_build() {
    [ -x "$BIN" ] || return 0
    [ -n "$(find "$PLUGIN_ROOT/src" "$PLUGIN_ROOT/Cargo.toml" "$PLUGIN_ROOT/Cargo.lock" \
            -newer "$BIN" -print -quit 2>/dev/null)" ]
}

if needs_build; then
    if HERDR_PLUGIN_ROOT="$PLUGIN_ROOT" sh "$PLUGIN_ROOT/bin/build"; then
        :
    elif [ -x "$BIN" ]; then
        say "the build failed; running the binary already built, which may be stale"
    else
        die "no layout binary at $BIN and it could not be built"
    fi
fi

[ -x "$BIN" ] || die "no layout binary at $BIN"

exec "$BIN" "$@"
